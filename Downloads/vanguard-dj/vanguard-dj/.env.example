# Vanguard DJ — Environment Variables Template
# Copy this file to .env and fill in your real secrets.
# NEVER commit .env to git.

# ==========================================
# BACKEND SECURITY (Required)
# ==========================================
# Generate a strong random key: openssl rand -hex 32
VANGUARD_API_KEY=your_hex_64_char_api_key_here

# Optional: Encrypt sensitive SQLite fields (32+ char string)
VANGUARD_DB_ENCRYPTION_KEY=your_db_encryption_passphrase_here

# Optional: Restrict CORS origins (comma-separated)
CORS_ORIGINS=https://vanguard-api.onrender.com,https://vanguard.vercel.app

# ==========================================
# FRONTEND (VITE_ prefixed vars are exposed to browser bundle)
# ==========================================
# Your Vanguard backend URL
VITE_VANGUARD_API_URL=https://vanguard-api.onrender.com

# Your Vanguard API key (same as backend, used in request headers)
VITE_VANGUARD_API_KEY=your_hex_64_char_api_key_here

# Spotify OAuth Client ID (32 hex chars)
# Get this from https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Optional: Explicit redirect URI override
# VITE_SPOTIFY_REDIRECT_URI=https://your-domain.com/callback

